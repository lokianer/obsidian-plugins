#!/bin/sh
# Reject attribution lines: the maintainer is the sole author (see CLAUDE.md).
msg_file="$1"
if grep -qiE '^co-authored-by:|generated with|generated by (claude|ai)|🤖|noreply@anthropic\.com' "$msg_file"; then
  echo "commit-msg: refusing commit — attribution lines (Co-Authored-By, 'Generated with', bot markers) are not allowed." >&2
  exit 1
fi
exit 0
