#!/bin/sh
# Refuse any push whose commits touch the private vault (see CLAUDE.md).
vault="Obsidian Plugins Vault/"
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  if git log --name-only --format= "$range" -- "$vault" | grep -q .; then
    echo "pre-push: refusing to push — commits touch '$vault', which must never leave this machine." >&2
    exit 1
  fi
done
exit 0
