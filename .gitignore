# Private working vault — never committed, never pushed (see CLAUDE.md)
/Obsidian Plugins Vault/

# Dependencies and build output
node_modules/
dist/
coverage/
main.js
*.log

# Local secrets and tool state
.env
.env.*
.claude/settings.local.json

# Brainstorming mockups (visual companion)
.superpowers/

# Example vault: personal Obsidian state and built plugins stay local
examples/vault/.obsidian/workspace*.json
examples/vault/.obsidian/plugins/
examples/vault/.trash/

# The project page's screenshots: copied from plugins/<id>/screenshots/ when the page is deployed
site/assets/

# Plugin build output (styles.css is bundled from each plugin's styles/)
plugins/*/main.js
plugins/*/styles.css
