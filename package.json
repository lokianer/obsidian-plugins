{
	"name": "obsidian-plugins",
	"private": true,
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"lint": "pnpm -r lint",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test",
		"build": "pnpm -r build",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
	},
	"devDependencies": {
		"prettier": "3.9.10"
	}
}
